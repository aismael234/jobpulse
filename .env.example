# Copy to .env (gitignored). jobpulse reads these at start-up; empty values count as unset.

# ntfy: the topic works like a password, since anyone who knows it can read your alerts.
# Generate one:  python3 -c "import secrets; print('jobpulse-' + secrets.token_urlsafe(24))"
NTFY_TOPIC=
# Only for a self-hosted ntfy server with access control:
NTFY_TOKEN=

# Discord, the optional second channel (Server Settings > Integrations > Webhooks):
DISCORD_WEBHOOK_URL=

# Dashboard basic auth (Milestone 3). Leave both empty to run without auth on 127.0.0.1.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Overrides database_url in config.yaml, e.g.
# postgresql+psycopg://jobpulse:change-me@postgres:5432/jobpulse
DATABASE_URL=

# Reserved for the optional LLM scoring layer (Milestone 4, not built).
LLM_API_KEY=
